# Copy to .env and fill in API_KEY, or let install.sh generate it.
# systemd reads this same file as EnvironmentFile, so use plain
# KEY=VALUE lines: no quotes, no "export", no shell expansion.

# Any faster-whisper model name or a local path.
# Smaller and faster: distil-large-v3, small, base, tiny
MODEL_SIZE=large-v3-turbo

# int8 is the right choice on CPU. int8_float32 and float32 are more
# accurate but several times slower.
COMPUTE_TYPE=int8

# Match these to the number of CPU cores you want to spend.
# Keep both values identical.
CPU_THREADS=2
OMP_NUM_THREADS=2

PORT=8000

# Absolute path, so systemd finds it regardless of the working
# directory. The model is downloaded here on first start.
MODELS_DIR=/opt/faster-whisper-fastapi/whisper_models

# Required. The service refuses to start without it.
# Generate with:  openssl rand -hex 32
# hex rather than base64 so no special characters upset systemd's
# EnvironmentFile parsing.
API_KEY=
